# Finsight v2 백엔드 환경 변수 목록
# 이 파일을 backends/.env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다(.gitignore).
# 각 변수의 용도는 설계서 "공통 기반 > 설정" 표를 따른다.

# ===== API 키 (필수) =====
# Claude API: 생성 모델
ANTHROPIC_API_KEY=
# OpenRouter: 임베딩(bge-m3)과 평가 judge 모델
OPENROUTER_KEY=
# OpenDART: 재무제표·공시
OPENDART_API_KEY=
# Tavily: 뉴스·웹 검색 (basic 검색 1크레딧, 종량제 1크레딧 0.008달러)
TAVILY_API_KEY=
# 국가법령정보 Open API 인증키(OC)
LAW_OC=

# ===== 선택 키 =====
# LangSmith: LANGSMITH_TRACING=true일 때만 필요
LANGSMITH_API_KEY=

# ===== 모델 =====
LLM_MODEL=claude-haiku-5-5
# 생성 모델 비교 실험 전용
LLM_MODEL_STRONG=claude-sonnet-5-5
# 평가용 judge 모델 ID (OpenRouter, Claude가 아닌 계열). 고르는 법은 설계서 "평가 설계 > 통계"
LLM_MODEL_JUDGE=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=baai/bge-m3

# ===== 저장소 =====
# docker-compose의 호스트 포트(8090). 백엔드 컨테이너 안에서는 compose가 http://weaviate:8080으로 덮어쓴다
WEAVIATE_URL=http://localhost:8090
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# 체크포인터·Store용 SQLite 파일
SQLITE_PATH=data/state.sqlite

# ===== 서버 =====
# /admin/* 인증 토큰
ADMIN_TOKEN=
# 허용 출처(쉼표 구분)
CORS_ORIGINS=http://localhost:5173

# ===== 캐시·예산 =====
# CacheBackend SQLite 위치(응답 캐시, 비용 장부)
CACHE_DIR=data/cache
# LLM 응답 캐시. 평가 실행에서만 true
LLM_CACHE=false
# Claude·OpenRouter·Tavily 누적 비용 상한(USD). 넘으면 새 유료 호출을 막는다
BUDGET_USD=9.0
# 프로젝트 누적 Tavily 검색 크레딧 상한
TAVILY_MAX_CREDITS=300
# 요청 하나에서 쓰는 Claude 입력+출력 토큰 상한
REQUEST_TOKEN_BUDGET=300000

# ===== 트레이싱 =====
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=finsight-v2
